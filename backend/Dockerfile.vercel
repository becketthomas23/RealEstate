FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

# Install exactly the dependencies recorded in uv.lock before copying the
# application source, so Vercel can reuse this build layer when code changes.
RUN pip install --no-cache-dir "uv>=0.9.27,<0.10.0"
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY README.md alembic.ini main.py ./
COPY migrations ./migrations
COPY src ./src
RUN uv sync --frozen --no-dev

EXPOSE 80

# Vercel supplies PORT to container services (80 is a safe local fallback).
CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT:-80}"]
